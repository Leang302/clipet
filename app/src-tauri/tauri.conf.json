{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipet",
  "version": "0.1.0",
  "identifier": "com.clipflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "history",
        "title": "Clipet",
        "width": 860,
        "height": 520,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "prompt",
        "title": "Fill in snippet — Clipet",
        "width": 440,
        "height": 340,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "editor",
        "title": "Annotate — Clipet",
        "width": 1000,
        "height": 700,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
